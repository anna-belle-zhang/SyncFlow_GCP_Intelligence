# SyncFlow GCP Intelligence - Environment Configuration
# Copy this file to .env and update with your values

# ==================================================
# GCP Configuration
# ==================================================
GCP_PROJECT=prismatic-smoke-463810-c1
BQ_DATASET=minietl
BQ_LOCATION=us-central1

# Path to service account JSON
# WSL: /home/username/.gcp/service-account.json
# Windows: C:\Users\Username\.gcp\service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/home/username/.gcp/service-account.json

# ==================================================
# Backend Server Configuration
# ==================================================
FLASK_APP=syncflow_server.py
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
DEBUG=True

# API Configuration
API_WORKERS=4
API_TIMEOUT=30

# ==================================================
# Frontend (Streamlit) Configuration
# ==================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_CLIENT_SHOW_ERROR_DETAILS=true

# ==================================================
# Database Configuration
# ==================================================
# BigQuery connection pooling
BQ_MAX_CONNECTIONS=10
BQ_TIMEOUT_SECONDS=300

# ==================================================
# Logging Configuration
# ==================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/syncflow.log

# ==================================================
# Docker Configuration
# ==================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ==================================================
# Development Configuration
# ==================================================
# Set to True for local development with sample data
USE_MOCK_DATA=False

# Performance analysis days
PERF_ANALYSIS_DAYS=7

# Cost analysis days
COST_ANALYSIS_DAYS=30

# ==================================================
# Optional: Generative AI Configuration
# ==================================================
# ONLY enable if you're extending SyncFlow with AI features
# DO NOT commit real API keys to Git - use secrets management instead
# See docs/SECURITY.md for proper key management

# Google Gemini API Key (optional, for future AI features)
# Get from: https://aistudio.google.com/app/apikeys
# GOOGLE_GENAI_API_KEY=your-api-key-here

# Use Vertex AI instead of Gemini API
# GOOGLE_GENAI_USE_VERTEXAI=True

# ==================================================
# Optional: Cloud Run Configuration
# ==================================================
# CLOUD_RUN_SERVICE_NAME=syncflow-backend
# CLOUD_RUN_REGION=us-central1
